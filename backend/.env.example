MEDICO_OLLAMA_BASE_URL=http://127.0.0.1:11434
MEDICO_OLLAMA_EMBED_MODEL=nomic-embed-text
MEDICO_LLM_CHAT_PROVIDER=openai
MEDICO_LLM_CHAT_MODEL=llama3.2:3b
MEDICO_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
MEDICO_OPENAI_API_KEY=local
MEDICO_CHROMA_PERSIST_DIR=vectorstore/chroma
MEDICO_CHROMA_COLLECTION=pcdt
MEDICO_RETRIEVAL_K=6
MEDICO_RAG_MAX_RETRIEVE_ATTEMPTS=2
MEDICO_RAG_RETRIEVE_CANDIDATES_K=30
MEDICO_RAG_RETRIEVE_FINAL_K=6
MEDICO_RAG_USE_LLM_RERANK=false
MEDICO_RAG_LLM_RERANK_TOP_N=12
MEDICO_RAG_REQUIRE_SOURCE_FOR_CLINICAL_ANSWER=true
MEDICO_RAG_DEBUG=false
# Busca especializada (N queries via LLM + fusão RRF). ON = caminho primário; OFF = RAG legado.
MEDICO_RAG_MULTI_QUERY_ENABLED=true
MEDICO_RAG_MULTI_QUERY_MAX=4
MEDICO_RAG_MULTI_QUERY_RRF_K=60
# MEDICO_RAG_MULTI_QUERY_MIN_P=0.2
# MEDICO_RAG_MULTI_QUERY_MAX_TOKENS=512
MEDICO_RAG_AUDIT_ENABLED=true
MEDICO_RAG_AUDIT_JSONL=../llm/data/audit/rag_interactions.jsonl
MEDICO_LLM_INTERACTION_LOG_ENABLED=false
# MEDICO_LLM_TEMPERATURE=0.8
# MEDICO_LLM_REPETITION_PENALTY=1.15
MEDICO_DATABASE_URL=sqlite+aiosqlite:///./assistente_medico.db
